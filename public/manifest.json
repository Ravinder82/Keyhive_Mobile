{
  "manifest_version": 3,
  "name": "AI Keychain",
  "version": "1.0.0",
  "description": "Local-first encrypted keychain for AI/API keys, with API testing and a private usage, cost and insight dashboard.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "AI Keychain",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "sidePanel"],
  "side_panel": {
    "default_path": "dashboard.html?side=true"
  },
  "host_permissions": [
    "https://api.openai.com/*",
    "https://api.anthropic.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://openrouter.ai/*",
    "https://api.dodopayments.com/*"
  ]
}
